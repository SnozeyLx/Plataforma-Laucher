<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Plataforma.Launcher.ViewModels"
        x:Class="Plataforma.Launcher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/logo_teste.ico"
        Title="Plataforma Launcher"
        Width="1120"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        Background="#090B10"
        TransparencyLevelHint="None">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#F4F6FB" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="#F4F6FB" />
            <Setter Property="Background" Value="#222631" />
            <Setter Property="BorderBrush" Value="#343946" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14,9" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#151821" />
            <Setter Property="BorderBrush" Value="#303543" />
            <Setter Property="Foreground" Value="#F4F6FB" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid IsVisible="{Binding !IsAuthenticated}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>
            <Border Margin="24"
                    CornerRadius="16"
                    Background="#11151D"
                    Padding="48">
                <StackPanel VerticalAlignment="Center" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                        <Image Source="/Assets/logo_teste.png"
                               Width="72"
                               Height="72"
                               Stretch="Uniform" />
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#8D96A8" Text="PLAYLAB" />
                            <TextBlock FontSize="11" Foreground="#AEB5C4" Text="Launcher" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock FontSize="42" FontWeight="Bold" Text="Sua biblioteca," />
                    <TextBlock FontSize="42" FontWeight="Bold" Foreground="#7C8CFF" Text="sempre disponível." />
                    <TextBlock Margin="0,12,0,0"
                               MaxWidth="520"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Foreground="#AEB5C4"
                               Text="Acesse seus jogos, acompanhe suas sessões e organize a experiência da plataforma em um único launcher." />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#0D1016"
                    BorderBrush="#202430"
                    BorderThickness="1,0,0,0"
                    Padding="48">
                <StackPanel Width="324"
                            Spacing="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="28" FontWeight="Bold" Text="Entrar" />
                    <TextBlock Foreground="#AEB5C4" Text="Use sua conta da plataforma." />
                    <TextBox PlaceholderText="E-mail"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding !IsBusy}" />
                    <CheckBox Content="Lembrar meu e-mail"
                              IsChecked="{Binding RememberEmail}"
                              IsEnabled="{Binding !IsBusy}" />
                    <TextBox PlaceholderText="Senha"
                             PasswordChar="*"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Esqueceu a senha?"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding ForgotPasswordCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#AEB5C4"
                            Padding="0,4" />
                    <TextBlock Foreground="#FF7A82"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasError}"
                               Text="{Binding ErrorMessage}" />
                    <TextBlock Foreground="#AEB5C4"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasStatusMessage}"
                               Text="{Binding StatusMessage}" />
                    <Button Content="Entrar na plataforma"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding LoginCommand}"
                            Background="#6574F7" />
                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsBusy}"
                                 Height="3"
                                 Foreground="#7C8CFF" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsAuthenticated}"
              ColumnDefinitions="220,*">
            <Border Background="#0D1016"
                    BorderBrush="#202430"
                    BorderThickness="0,0,1,0"
                    Padding="16">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,8,8,20">
                        <Image Source="/Assets/logo_teste.png"
                               Width="42"
                               Height="42"
                               Stretch="Uniform" />
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="#7C8CFF" Text="PLAYLAB" />
                            <TextBlock FontSize="18" FontWeight="Bold" Text="Launcher" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,12">
                        <Button Content="Biblioteca"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding ShowLibraryCommand}"
                                Background="#6574F7" />
                        <Button Content="Loja"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding ShowStoreCommand}" />
                    </StackPanel>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding PurchasedGames}"
                             SelectedItem="{Binding SelectedGame}"
                             Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        CornerRadius="8"
                                        Background="#151923">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="42"
                                                Height="42"
                                                CornerRadius="7"
                                                Background="#151923">
                                            <Image Source="/Assets/logo_teste.png"
                                                   Width="42"
                                                   Height="42"
                                                   Stretch="Uniform" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock FontSize="11" Foreground="#929AAA" Text="{Binding Status}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3"
                          ColumnDefinitions="38,*,Auto"
                          Margin="4">
                        <Button Width="38"
                                Height="38"
                                Padding="0"
                                CornerRadius="19"
                                Background="#6574F7"
                                Command="{Binding OpenProfileCommand}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Text="{Binding ProfileIconGlyph}" />
                        </Button>
                        <Button Grid.Column="1"
                                Margin="8,0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding OpenProfileCommand}">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontSize="11" Foreground="#929AAA" Text="Conectado" />
                                <TextBlock MaxWidth="88"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding PlayerName}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                CornerRadius="16"
                                Content="↪"
                                ToolTip.Tip="Sair"
                                IsEnabled="{Binding !IsBusy}"
                                Command="{Binding LogoutCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Grid Margin="28,20,28,12" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="12"
                                   Foreground="#929AAA"
                                   Text="{Binding CurrentSection}" />
                        <TextBlock FontSize="24"
                                   FontWeight="Bold"
                                   Text="{Binding SelectedGame.Title}"
                                   IsVisible="{Binding IsLibrarySection}" />
                        <TextBlock FontSize="24"
                                   FontWeight="Bold"
                                   Text="Loja"
                                   IsVisible="{Binding IsStoreSection}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="28,0,28,28"
                              IsVisible="{Binding IsLibrarySection}">
                    <StackPanel Spacing="16">
                        <Border Height="300"
                                CornerRadius="14"
                                ClipToBounds="True"
                                Background="#141A24">
                            <Grid>
                                <Border Opacity="0.95">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Offset="0" Color="#252E43" />
                                            <GradientStop Offset="0.55" Color="#171C29" />
                                            <GradientStop Offset="1" Color="#5A64A8" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Ellipse Width="220"
                                         Height="220"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Margin="0,0,70,-40"
                                         Fill="#6574F7"
                                         Opacity="0.28" />
                                <StackPanel Margin="32"
                                            VerticalAlignment="Bottom"
                                            Spacing="8">
                                    <Border HorizontalAlignment="Left"
                                            Padding="9,5"
                                            CornerRadius="6"
                                            Background="#6574F7">
                                        <TextBlock FontSize="11" FontWeight="Bold" Text="LICENÇA CONFIRMADA" />
                                    </Border>
                                    <TextBlock FontSize="38" FontWeight="Bold" Text="{Binding SelectedGame.Title}" />
                                    <TextBlock FontSize="15" Foreground="#CDD3DF" Text="{Binding SelectedGame.Genre}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="2*,1*">
                            <Border Margin="0,0,8,0"
                                    Padding="22"
                                    CornerRadius="12"
                                    Background="#11151D"
                                    BorderBrush="#202430"
                                    BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="18" FontWeight="Bold" Text="Sobre o jogo" />
                                    <TextBlock Foreground="#ADB5C4"
                                               TextWrapping="Wrap"
                                               Text="{Binding SelectedGame.Description}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="22"
                                    CornerRadius="12"
                                    Background="#11151D"
                                    BorderBrush="#202430"
                                    BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <Button Content="Baixar e instalar"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="#6574F7"
                                            FontWeight="Bold"
                                            IsEnabled="{Binding SelectedGame.IsWindowsBuildAvailable}"
                                            Command="{Binding DownloadWindowsBuildCommand}" />
                                    <ComboBox ItemsSource="{Binding SelectedGame.ExecutableCandidates}"
                                              SelectedItem="{Binding SelectedGame.SelectedExecutablePath}"
                                              IsVisible="{Binding SelectedGame.IsExecutableSelectionRequired}"
                                              PlaceholderText="Selecione o executável principal" />
                                    <Button Content="Jogar instalado"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            IsEnabled="{Binding SelectedGame.CanLaunchInstalledBuild}"
                                            Command="{Binding PlayInstalledBuildCommand}" />
                                    <Button Content="Jogar no navegador"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            IsEnabled="{Binding SelectedGame.IsWebGlBuildAvailable}"
                                            Command="{Binding PlayWebGlBuildCommand}" />
                                    <TextBlock Foreground="#929AAA"
                                               TextWrapping="Wrap"
                                               Text="O acesso só é liberado pela API para builds publicados." />
                                    <TextBlock Foreground="#929AAA"
                                               Text="{Binding SelectedGame.InstalledVersion, StringFormat='Versão {0}'}" />
                                    <TextBlock Foreground="#929AAA"
                                               Text="{Binding SelectedGame.LastPlayed}" />
                                    <TextBlock Foreground="#929AAA"
                                               Text="{Binding SelectedGame.PlayTime}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Foreground="#FF7A82"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasError}"
                                   Text="{Binding ErrorMessage}" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1"
                              Margin="28,0,28,28"
                              IsVisible="{Binding IsStoreSection}">
                    <StackPanel Spacing="18">
                        <Border Height="220"
                                CornerRadius="14"
                                ClipToBounds="True"
                                Background="#151A26">
                            <Grid>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Offset="0" Color="#33418A" />
                                            <GradientStop Offset="0.58" Color="#1A2033" />
                                            <GradientStop Offset="1" Color="#6574F7" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Margin="30"
                                            VerticalAlignment="Center"
                                            Spacing="7">
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#DDE1FF" Text="DESTAQUES DA PLATAFORMA" />
                                    <TextBlock FontSize="34" FontWeight="Bold" Text="Novos mundos esperam por você" />
                                    <TextBlock Foreground="#CDD3DF" Text="Explore jogos, expansões e itens cosméticos." />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock FontSize="18" FontWeight="Bold" Text="Jogos em destaque" />
                        <ItemsControl ItemsSource="{Binding StoreGames}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StoreGameViewModel">
                                    <Border Margin="0,0,12,12"
                                            Padding="14"
                                            CornerRadius="12"
                                            Background="#11151D"
                                            BorderBrush="#202430"
                                            BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <Border Height="150"
                                                    CornerRadius="9"
                                                    Background="#252E43">
                                                <Grid>
                                                    <Ellipse Width="120"
                                                             Height="120"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Bottom"
                                                             Margin="0,0,-20,-35"
                                                             Fill="#6574F7"
                                                             Opacity="0.36" />
                                                    <TextBlock Margin="18"
                                                               VerticalAlignment="Bottom"
                                                               FontSize="28"
                                                               FontWeight="Bold"
                                                               Text="{Binding CoverInitial}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock FontSize="17" FontWeight="Bold" Text="{Binding Title}" />
                                            <TextBlock FontSize="12" Foreground="#929AAA" Text="{Binding Genre}" />
                                            <TextBlock Height="48"
                                                       TextWrapping="Wrap"
                                                       Foreground="#ADB5C4"
                                                       Text="{Binding Description}" />

                                            <TextBlock FontSize="15"
                                                       FontWeight="Bold"
                                                       Text="{Binding Price}" />
                                            <Button Content="Na biblioteca"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    IsEnabled="False"
                                                    IsVisible="{Binding IsPurchased}" />
                                            <TextBlock Foreground="#929AAA"
                                                       Text="A licença de teste é gerenciada pela API."
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding IsSandboxManaged}" />
                                            <Button Content="Adicionar à biblioteca"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Background="#6574F7"
                                                    IsVisible="{Binding CanPurchase}"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).BuyGameCommand}"
                                                    CommandParameter="{Binding}" />

                                            <Border Height="1" Background="#252A36" />
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#929AAA"
                                                       Text="ITENS DO JOGO" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StoreItemViewModel">
                                                        <Border Margin="0,4"
                                                                Padding="9"
                                                                CornerRadius="7"
                                                                Background="#171B25">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Text="{Binding Name}" />
                                                                    <TextBlock FontSize="10"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="#929AAA"
                                                                               Text="{Binding Description}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1"
                                                                           Margin="8,0,0,0"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Text="{Binding Price}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Foreground="#FF7A82"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasError}"
                                   Text="{Binding ErrorMessage}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Border IsVisible="{Binding IsProfileModalOpen}"
                Background="#99000000"
                Padding="20">
            <Border Width="520"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="16"
                    Background="#11151D"
                    BorderBrush="#303543"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="12" Foreground="#929AAA" Text="CONFIGURAÇÕES DA CONTA" />
                            <TextBlock FontSize="24" FontWeight="Bold" Text="Editar perfil" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="34"
                                Height="34"
                                Padding="0"
                                CornerRadius="17"
                                Content="×"
                                Command="{Binding CloseProfileCommand}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="8">
                        <TextBlock FontSize="12" Foreground="#929AAA" Text="Gamertag" />
                        <TextBox PlaceholderText="Seu nome público"
                                 MaxLength="24"
                                 Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="10">
                        <TextBlock FontSize="12" Foreground="#929AAA" Text="Ícone do perfil" />
                        <Border Padding="12"
                                CornerRadius="10"
                                Background="#171B25"
                                BorderBrush="#6574F7"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="46"
                                        Height="46"
                                        CornerRadius="23"
                                        Background="#6574F7">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Text="{Binding ProfileIconGlyph}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="12" Foreground="#929AAA" Text="Ícone selecionado" />
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding ProfileIconId, StringFormat='Opção {0}'}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <WrapPanel ItemWidth="58" ItemHeight="58">
                            <Button Margin="4" Width="46" Height="46" Padding="0" CornerRadius="23"
                                    Background="#6574F7"
                                    BorderThickness="2"
                                    Command="{Binding SelectProfileIconCommand}" CommandParameter="1">
                                <Canvas Width="46" Height="46">
                                    <Ellipse Canvas.Left="13" Canvas.Top="8" Width="20" Height="20" Fill="#F4F6FB"/>
                                    <Ellipse Canvas.Left="8" Canvas.Top="28" Width="30" Height="16" Fill="#252B60"/>
                                </Canvas>
                            </Button>
                            <Button Margin="4" Width="46" Height="46" Padding="0" CornerRadius="23"
                                    Background="#D66A6A" BorderThickness="2"
                                    Command="{Binding SelectProfileIconCommand}" CommandParameter="2">
                                <Canvas Width="46" Height="46">
                                    <Ellipse Canvas.Left="13" Canvas.Top="8" Width="20" Height="20" Fill="#FFE0B2"/>
                                    <Path Canvas.Left="8" Canvas.Top="26" Fill="#5E2430" Data="M 0,14 C 2,2 28,2 30,14 Z"/>
                                </Canvas>
                            </Button>
                            <Button Margin="4" Width="46" Height="46" Padding="0" CornerRadius="23"
                                    Background="#43A68A" BorderThickness="2"
                                    Command="{Binding SelectProfileIconCommand}" CommandParameter="3">
                                <Canvas Width="46" Height="46">
                                    <Ellipse Canvas.Left="13" Canvas.Top="8" Width="20" Height="20" Fill="#D5FFF2"/>
                                    <Rectangle Canvas.Left="9" Canvas.Top="27" Width="28" Height="13" RadiusX="6" RadiusY="6" Fill="#174F43"/>
                                </Canvas>
                            </Button>
                            <Button Margin="4" Width="46" Height="46" Padding="0" CornerRadius="23"
                                    Background="#DAA84D" BorderThickness="2"
                                    Command="{Binding SelectProfileIconCommand}" CommandParameter="4">
                                <Canvas Width="46" Height="46">
                                    <Ellipse Canvas.Left="13" Canvas.Top="8" Width="20" Height="20" Fill="#FFF2C9"/>
                                    <Polygon Points="23,25 31,39 15,39" Fill="#7A5121"/>
                                </Canvas>
                            </Button>
                            <Button Margin="4" Width="46" Height="46" Padding="0" CornerRadius="23"
                                    Background="#7B66C7" BorderThickness="2"
                                    Command="{Binding SelectProfileIconCommand}" CommandParameter="5">
                                <Canvas Width="46" Height="46">
                                    <Ellipse Canvas.Left="13" Canvas.Top="8" Width="20" Height="20" Fill="#EFE7FF"/>
                                    <Polygon Points="23,25 34,39 12,39" Fill="#403168"/>
                                </Canvas>
                            </Button>
                            <Button Margin="4" Width="46" Height="46" Padding="0" CornerRadius="23"
                                    Background="#4C91C8" BorderThickness="2"
                                    Command="{Binding SelectProfileIconCommand}" CommandParameter="6">
                                <Canvas Width="46" Height="46">
                                    <Ellipse Canvas.Left="13" Canvas.Top="8" Width="20" Height="20" Fill="#D9F2FF"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="27" Width="30" Height="13" RadiusX="3" RadiusY="3" Fill="#214F74"/>
                                </Canvas>
                            </Button>
                            <Button Margin="4" Width="46" Height="46" Padding="0" CornerRadius="23"
                                    Background="#D873A8" BorderThickness="2"
                                    Command="{Binding SelectProfileIconCommand}" CommandParameter="7">
                                <Canvas Width="46" Height="46">
                                    <Ellipse Canvas.Left="13" Canvas.Top="8" Width="20" Height="20" Fill="#FFE3F3"/>
                                    <Ellipse Canvas.Left="8" Canvas.Top="27" Width="30" Height="13" Fill="#74365B"/>
                                </Canvas>
                            </Button>
                            <Button Margin="4" Width="46" Height="46" Padding="0" CornerRadius="23"
                                    Background="#607287" BorderThickness="2"
                                    Command="{Binding SelectProfileIconCommand}" CommandParameter="8">
                                <Canvas Width="46" Height="46">
                                    <Ellipse Canvas.Left="13" Canvas.Top="8" Width="20" Height="20" Fill="#E7EDF3"/>
                                    <Polygon Points="23,25 35,39 11,39" Fill="#303C48"/>
                                </Canvas>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Foreground="#FF7A82"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasError}"
                               Text="{Binding ErrorMessage}" />

                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                        <TextBlock Foreground="#929AAA"
                                   VerticalAlignment="Center"
                                   Text="{Binding SignedInEmail}" />
                        <Button Grid.Column="1"
                                Content="Salvar perfil"
                                IsEnabled="{Binding !IsBusy}"
                                Background="#6574F7"
                                Command="{Binding SaveProfileCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
